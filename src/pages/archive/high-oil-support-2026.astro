---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { siteConfig, archivedSupportLinks } from "../../data/portal.js";

const title = "2026 고유가 피해지원금 종료 자료 | 오일가이드";
const description = "2026년 고유가 피해지원금 대상, 신청방법, 소득 하위 70% 기준에 관한 종료 자료를 보존한 안내 페이지입니다.";
const canonicalUrl = `${siteConfig.siteUrl}/archive/high-oil-support-2026/`;
---

<BaseLayout title={title} description={description} siteName={siteConfig.brandName} canonicalUrl={canonicalUrl} ogImageUrl={new URL(siteConfig.ogImagePath, siteConfig.siteUrl).toString()} locale={siteConfig.locale} robots="noindex, follow, max-image-preview:large">
  <Header brandName={siteConfig.brandName} />
  <main class="page-shell">
    <section class="subpage-hero">
      <span class="eyebrow">ARCHIVED INFORMATION</span>
      <h1>2026 고유가 피해지원금<br />종료 자료</h1>
      <p>이 페이지는 과거 제도의 확인을 위한 기록입니다. 현재 신청 페이지가 아니며, 최신 지원은 에너지 지원 메뉴에서 확인할 수 있습니다.</p>
    </section>
    <section class="content-section content-section--compact">
      <div class="legal-card">
        <h2 style="margin-top:0">현재 신청이 종료된 정보입니다</h2>
        <p>당시 지원 대상과 소득 기준, 신청 절차를 다시 확인하려는 분을 위해 관련 글을 보존합니다. 검색 결과에서 이 자료를 보셨다면 게시일과 현재 날짜를 반드시 비교해 주세요.</p>
        <div class="archive__links" style="margin-top:24px">
          {archivedSupportLinks.map((item) => <a href={item.href}><span>{item.title}</span><span>자료 보기 ↗</span></a>)}
        </div>
        <div style="margin-top:28px"><a class="button" href="/benefits/">현재 지원 제도 보기</a></div>
      </div>
    </section>
  </main>
  <Footer brandName={siteConfig.brandName} ownerName={siteConfig.ownerName} supportEmail={siteConfig.supportEmail} />
</BaseLayout>
