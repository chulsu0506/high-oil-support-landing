---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../data/portal.js";

const title = "개인정보처리방침 | 오일가이드";
const description = "오일가이드의 위치정보, 접속정보, 광고 서비스 관련 개인정보 처리 기준을 안내합니다.";
const canonicalUrl = `${siteConfig.siteUrl}/privacy-policy`;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  url: canonicalUrl,
  description,
  inLanguage: "ko-KR",
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImageUrl={new URL(siteConfig.ogImagePath, siteConfig.siteUrl).toString()}
  locale={siteConfig.locale}
  schema={schema}
  adsenseClientId={siteConfig.adsenseClientId}
>
  <Header brandName={siteConfig.brandName} />

  <main class="page-shell">
    <section class="legal-card">
      <h1>개인정보처리방침</h1>
      <div>
        <p>
          오일가이드는 기름값, 주유소 위치, 에너지 지원 정보를 제공하며 별도의 회원가입이나 자체 결제 기능을 운영하지 않습니다.
        </p>
        <h2>위치정보</h2>
        <p>
          내 주변 주유소 찾기 기능은 사용자가 브라우저에서 위치 권한을 허용한 경우에만 현재 좌표를 사용합니다. 좌표와 사용자가 입력한 지역·주소는 주변 검색과 지도 표시를 위해 오일가이드, 한국석유공사 오피넷 및 카카오맵 서비스에 일시적으로 전달될 수 있으며, 오일가이드가 별도로 저장하거나 회원 정보와 결합하지 않습니다.
        </p>
        <p>
          사이트 운영 과정에서 기본적인 접속 로그, 브라우저 정보, 광고 노출 및 클릭 측정을 위한
          기술 정보가 수집될 수 있습니다. 이러한 정보는 사이트 운영, 통계 확인, 광고 서비스 제공을
          위한 범위 내에서 활용됩니다.
        </p>
        <p>
          본 사이트에는 Google AdSense 등 제3자 광고 서비스가 적용될 수 있으며, 관련 서비스는
          쿠키를 사용해 사용자 맞춤형 광고를 제공할 수 있습니다. 광고와 관련된 세부 정책은 각
          서비스 제공자의 정책을 따릅니다.
        </p>
        <p>
          외부 링크를 통해 이동한 페이지의 개인정보 처리 방식은 해당 사이트의 정책을 따르며, 본
          사이트는 외부 사이트의 운영 및 데이터 처리 방식에 대해 직접 통제하지 않습니다.
        </p>
        <p>
          개인정보 처리와 관련한 문의는 아래 이메일로 연락할 수 있습니다:
          <a class="font-semibold text-stone-900" href={`mailto:${siteConfig.supportEmail}`}>
            {siteConfig.supportEmail}
          </a>
        </p>
      </div>
    </section>
  </main>

  <Footer
    brandName={siteConfig.brandName}
    ownerName={siteConfig.ownerName}
    supportEmail={siteConfig.supportEmail}
  />
</BaseLayout>
