---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { siteConfig } from "../data/portal.js";

const title = "이용약관 | 오일가이드";
const description = "오일가이드의 유가정보, 계산기, 지도, 외부 지원정보 이용 기준과 면책 사항을 안내합니다.";
const canonicalUrl = `${siteConfig.siteUrl}/terms`;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  url: canonicalUrl,
  description,
  inLanguage: "ko-KR",
};
---

<BaseLayout
  title={title}
  description={description}
  canonicalUrl={canonicalUrl}
  ogImageUrl={new URL(siteConfig.ogImagePath, siteConfig.siteUrl).toString()}
  locale={siteConfig.locale}
  schema={schema}
  adsenseClientId={siteConfig.adsenseClientId}
>
  <Header brandName={siteConfig.brandName} />

  <main class="page-shell">
    <section class="legal-card">
      <h1>이용약관</h1>
      <div>
        <p>
          오일가이드는 공개된 유가 정보, 주유비 계산, 주변 주유소 위치, 에너지 지원 제도를 이용하기 쉽게 정리하는 생활정보 서비스입니다.
        </p>
        <p>
          유가와 주유소 정보는 제공처의 갱신 시점에 따라 실제 현장과 차이가 날 수 있습니다. 계산 결과는 입력값에 따른 예상치이며 실제 결제액이나 절약액을 보장하지 않습니다.
        </p>
        <p>
          운영자는 본 사이트의 정보 정확성을 위해 노력하지만, 정책 변경, 일정 변경, 외부 사이트
          변경으로 인해 일부 내용이 실제와 다를 수 있습니다. 이용자는 중요한 신청 전에 최신 내용을
          다시 확인해야 합니다.
        </p>
        <p>
          본 사이트는 외부 사이트 링크를 포함할 수 있으며, 외부 사이트 이용 중 발생하는 문제에 대해
          직접 책임을 지지 않습니다.
        </p>
        <p>
          사이트 이용 및 문의는 아래 이메일을 통해 연락할 수 있습니다:
          <a class="font-semibold text-stone-900" href={`mailto:${siteConfig.supportEmail}`}>
            {siteConfig.supportEmail}
          </a>
        </p>
      </div>
    </section>
  </main>

  <Footer
    brandName={siteConfig.brandName}
    ownerName={siteConfig.ownerName}
    supportEmail={siteConfig.supportEmail}
  />
</BaseLayout>
