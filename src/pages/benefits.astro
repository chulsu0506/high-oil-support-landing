---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import AdBlock from "../components/AdBlock.astro";
import { siteConfig, supportPrograms } from "../data/portal.js";

const title = "2026 에너지·유류비 지원 제도 | 에너지바우처·유류세 환급";
const description = "2026년 신청 가능한 에너지바우처, 석탄 전환 지원, 경차 유류세 환급, 운송사업자 유가보조금의 대상과 기간을 확인하세요.";
const canonicalUrl = `${siteConfig.siteUrl}/benefits/`;
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  url: canonicalUrl,
  description,
  inLanguage: "ko-KR",
  dateModified: siteConfig.updatedAt,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: supportPrograms.map((item, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: item.title,
      url: item.href,
    })),
  },
};
---

<BaseLayout title={title} description={description} siteName={siteConfig.brandName} canonicalUrl={canonicalUrl} ogImageUrl={new URL(siteConfig.ogImagePath, siteConfig.siteUrl).toString()} locale={siteConfig.locale} schema={schema} adsenseClientId={siteConfig.adsenseClientId}>
  <Header brandName={siteConfig.brandName} />
  <main class="page-shell">
    <section class="subpage-hero">
      <span class="eyebrow">2026 ENERGY SUPPORT</span>
      <h1>지금 확인할 수 있는<br />에너지·유류비 지원</h1>
      <p>종료된 일회성 지원금과 현재 이용 가능한 제도를 분리했습니다. 아래 날짜는 2026년 9월 9일 확인 기준이며 최종 자격은 각 공식 기관에서 확인해야 합니다.</p>
    </section>
    <section class="content-section content-section--compact">
      <div class="program-list">
        {supportPrograms.map((program) => (
          <a class="program-item" href={program.href} target="_blank" rel="noopener noreferrer">
            <span class="status-chip">{program.status}</span>
            <div><h3>{program.title}</h3><p>{program.summary}<br />출처: {program.source}</p></div>
            <div class="program-date"><span>신청·운영 기간</span><strong>{program.period}</strong></div>
            <span class="program-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
    </section>
    <AdBlock clientId={siteConfig.adsenseClientId} slotId={siteConfig.adsenseSlotId} />
    <section class="content-section content-section--compact">
      <div class="legal-card">
        <h2 style="margin-top:0">신청 전 준비할 것</h2>
        <p>가구원 수, 주민등록상 주소, 기초생활보장 또는 차상위 여부, 현재 사용하는 냉난방 에너지를 먼저 확인하면 대상 조회가 수월합니다. 운송사업자 지원은 차량과 사업자 자격에 따라 절차가 다릅니다.</p>
        <h2>공식 안내를 마지막으로 확인하세요</h2>
        <p>지원금액과 신청기간은 예산 또는 지침에 따라 달라질 수 있습니다. 오일가이드는 제도를 찾기 쉽게 정리하며 신청 접수나 대상 판정을 직접 처리하지 않습니다.</p>
      </div>
    </section>
  </main>
  <Footer brandName={siteConfig.brandName} ownerName={siteConfig.ownerName} supportEmail={siteConfig.supportEmail} />
</BaseLayout>
