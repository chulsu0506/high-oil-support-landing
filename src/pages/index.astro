---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SectionHeading from "../components/SectionHeading.astro";
import FuelPriceBoard from "../components/FuelPriceBoard.astro";
import FuelCalculator from "../components/FuelCalculator.astro";
import NearbyStations from "../components/NearbyStations.astro";
import AdBlock from "../components/AdBlock.astro";
import {
  archivedSupportLinks,
  faqItems,
  savingGuides,
  siteConfig,
  supportPrograms,
} from "../data/portal.js";

const canonicalUrl = siteConfig.siteUrl;
const ogImageUrl = new URL(siteConfig.ogImagePath, siteConfig.siteUrl).toString();
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteConfig.brandName,
    alternateName: "기름값·에너지비 절약센터",
    url: siteConfig.siteUrl,
    inLanguage: "ko-KR",
  },
  {
    "@context": "https://schema.org",
    "@type": "WebPage",
    name: siteConfig.siteTitle,
    url: canonicalUrl,
    description: siteConfig.siteDescription,
    inLanguage: "ko-KR",
    datePublished: siteConfig.publishedAt,
    dateModified: siteConfig.updatedAt,
    primaryImageOfPage: { "@type": "ImageObject", url: ogImageUrl },
    about: ["전국 평균 유가", "주유비 계산", "주변 주유소", "에너지바우처", "유가보조금"],
  },
  {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqItems.map((item) => ({
      "@type": "Question",
      name: item.question,
      acceptedAnswer: { "@type": "Answer", text: item.answer },
    })),
  },
];
---

<BaseLayout
  title={siteConfig.siteTitle}
  description={siteConfig.siteDescription}
  siteName={siteConfig.brandName}
  canonicalUrl={canonicalUrl}
  ogImageUrl={ogImageUrl}
  locale={siteConfig.locale}
  schema={schema}
  adsenseClientId={siteConfig.adsenseClientId}
>
  <Header brandName={siteConfig.brandName} />

  <main class="page-shell">
    <section class="hero reveal">
      <div class="hero__copy">
        <span class="eyebrow">오늘의 유가와 에너지비를 한 곳에서</span>
        <h1>
          <span>기름값은 매일</span>
          <span class="hero-line-two"><span>바뀌고, </span><em>절약은 숫자로</em></span>
          <span>시작됩니다</span>
        </h1>
        <p class="hero__lede">
          전국 평균 유가부터 내 차의 월 주유비, 주변 주유소, 지금 신청할 수 있는 에너지 지원까지 필요한 순서대로 확인하세요.
        </p>
        <div class="hero__actions">
          <a class="button button--amber" href="/fuel-cost-calculator/">
            주유비 계산하기
            <svg viewBox="0 0 24 24" fill="none"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
          <a class="button button--light" href="#nearby-stations">내 주변 주유소 찾기</a>
        </div>
      </div>
      <div class="hero__visual">
        <img src="/oilguide-hero.png" alt="해질녘 주유소에서 차량에 주유하는 모습" width="1536" height="1152" fetchpriority="high" />
        <div class="hero__caption">
          <span>OILGUIDE QUICK START</span>
          <strong>오늘 가격을 확인하고<br />내 이동비를 먼저 계산하세요.</strong>
        </div>
      </div>
    </section>

    <FuelPriceBoard />

    <nav class="utility-nav reveal" aria-label="빠른 이동">
      <a href="#today-price"><b>01</b><strong>오늘의 유가</strong><span>휘발유·경유·LPG</span></a>
      <a href="/fuel-cost-calculator/"><b>02</b><strong>주유비 계산</strong><span>월·연간 비용 확인</span></a>
      <a href="#nearby-stations"><b>03</b><strong>주변 주유소</strong><span>내 위치 반경 5km</span></a>
      <a href="/benefits/"><b>04</b><strong>지원금 찾기</strong><span>에너지·유류비 지원</span></a>
    </nav>

    <section class="content-section reveal" id="calculator">
      <FuelCalculator />
    </section>

    <AdBlock clientId={siteConfig.adsenseClientId} slotId={siteConfig.adsenseSlotId} />

    <section class="content-section reveal">
      <NearbyStations />
    </section>

    <section class="content-section reveal" id="benefits">
      <SectionHeading
        kicker="ENERGY SUPPORT"
        title="놓치기 쉬운 에너지 지원도 함께 확인하세요"
        description="현재 신청 가능한 제도와 상시 운영 제도를 구분했습니다. 대상과 기간은 바뀔 수 있으므로 신청 전 공식 안내에서 최종 조건을 확인하세요."
      />
      <div class="program-list">
        {supportPrograms.map((program) => (
          <a class="program-item" href={program.href} target="_blank" rel="noopener noreferrer">
            <span class="status-chip">{program.status}</span>
            <div><h3>{program.title}</h3><p>{program.summary}</p></div>
            <div class="program-date"><span>신청·운영 기간</span><strong>{program.period}</strong></div>
            <span class="program-arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>
      <div style="margin-top: 24px">
        <a class="button button--light" href="/benefits/">지원 제도 한 번에 보기</a>
      </div>
    </section>

    <section class="content-section reveal" id="saving-guides">
      <SectionHeading
        kicker="PRACTICAL SAVING"
        title="가격 비교 다음에 챙길 실제 절약 습관"
        description="멀리 있는 최저가만 좇기보다 내 이동 패턴, 차량 상태, 할인 한도를 함께 보는 것이 꾸준한 절약에 더 효과적입니다."
      />
      <div class="guide-grid">
        {savingGuides.map((guide) => (
          <a class="guide-card" href={guide.href}>
            <span class="guide-card__number">GUIDE {guide.number}</span>
            <h3>{guide.title}</h3>
            <p>{guide.text}</p>
          </a>
        ))}
      </div>
    </section>

    <AdBlock clientId={siteConfig.adsenseClientId} slotId={siteConfig.adsenseSlotId} />

    <aside class="archive reveal">
      <div>
        <small>PAST SUPPORT ARCHIVE</small>
        <h2>종료된 고유가 피해지원금 자료</h2>
        <p>과거 신청 당시의 기준을 확인하려는 분을 위해 기존 자료는 기록용으로 보존합니다. 현재 신청 가능한 지원으로 오해하지 않도록 종료 자료로 분리했습니다.</p>
      </div>
      <div class="archive__links">
        {archivedSupportLinks.map((item) => <a href={item.href}><span>{item.title}</span><span>과거 자료 ↗</span></a>)}
      </div>
    </aside>

    <section class="content-section content-section--compact reveal">
      <SectionHeading kicker="FREQUENTLY ASKED" title="이용 전에 확인해 주세요" />
      <div class="faq">
        {faqItems.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer brandName={siteConfig.brandName} ownerName={siteConfig.ownerName} supportEmail={siteConfig.supportEmail} />

  <script is:inline>
    const revealItems = document.querySelectorAll(".reveal");
    if ("IntersectionObserver" in window && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add("is-visible");
          observer.unobserve(entry.target);
        });
      }, { threshold: 0.08, rootMargin: "0px 0px -6% 0px" });
      revealItems.forEach((item) => observer.observe(item));
    } else {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    }
  </script>
</BaseLayout>
