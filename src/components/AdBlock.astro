---
const { clientId = "", slotId = "", className = "" } = Astro.props;
---

{clientId && slotId && (
  <aside class:list={["ad-shell", className]} aria-label="광고">
    <span>ADVERTISEMENT</span>
    <ins class="adsbygoogle" style="display:block" data-ad-client={clientId} data-ad-slot={slotId} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </aside>
)}
