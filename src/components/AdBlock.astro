---
const {
  clientId = "",
  slotId = "",
  label = "sponsored",
  className = "",
} = Astro.props;
---

{
  clientId && slotId && (
    <section class:list={["reveal rounded-[2rem] border border-stone-200/80 bg-white p-6 shadow-[0_18px_46px_rgba(15,23,42,0.04)] md:p-8", className]}>
      <p class="text-[0.72rem] font-semibold uppercase tracking-[0.24em] text-stone-400">
        {label}
      </p>
      <div class="mt-4 overflow-hidden rounded-[1.5rem] border border-stone-200/80 bg-stone-50 px-3 py-4">
        <ins
          class="adsbygoogle"
          style="display:block"
          data-ad-client={clientId}
          data-ad-slot={slotId}
          data-ad-format="auto"
          data-full-width-responsive="true"
        ></ins>
      </div>
      <script is:inline>
        (adsbygoogle = window.adsbygoogle || []).push({});
      </script>
    </section>
  )
}
