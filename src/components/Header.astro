---
const { brandName, primaryCtaUrl } = Astro.props;
---

<header class="fixed inset-x-0 top-0 z-50 px-4 pt-4 md:px-6">
  <div class="mx-auto flex max-w-6xl items-center justify-between rounded-full border border-stone-200/80 bg-white/92 px-4 py-3 shadow-[0_12px_30px_rgba(15,23,42,0.06)] backdrop-blur md:px-6">
    <a href="/" class="flex items-center gap-3">
      <span class="grid size-10 place-items-center rounded-full bg-[linear-gradient(135deg,#fff1df,#ffd7b4)]">
        <span class="size-4 rounded-full bg-[linear-gradient(135deg,#f4a261,#d9773b)]"></span>
      </span>
      <div>
        <strong class="block text-sm text-stone-900 md:text-base">{brandName}</strong>
      </div>
    </a>

    <nav class="hidden items-center gap-2 md:flex">
      <a
        class="rounded-full px-4 py-2 text-sm text-stone-600 transition hover:bg-stone-100 hover:text-stone-900"
        href="/#summary"
      >
        핵심 안내
      </a>
      <a
        class="rounded-full px-4 py-2 text-sm text-stone-600 transition hover:bg-stone-100 hover:text-stone-900"
        href="/#payout"
      >
        지급 요약
      </a>
      <a
        class="rounded-full px-4 py-2 text-sm text-stone-600 transition hover:bg-stone-100 hover:text-stone-900"
        href="/#faq"
      >
        자주 묻는 질문
      </a>
      <a
        class="inline-flex min-h-11 items-center justify-center rounded-full bg-[linear-gradient(135deg,#ea8c4d,#d36e33)] px-5 text-sm font-semibold text-white shadow-[0_12px_24px_rgba(211,110,51,0.22)] transition hover:-translate-y-0.5"
        href={primaryCtaUrl}
      >
        지원 대상 확인
      </a>
    </nav>

    <a
      class="inline-flex min-h-10 items-center justify-center rounded-full bg-[linear-gradient(135deg,#ea8c4d,#d36e33)] px-4 text-sm font-semibold text-white shadow-[0_10px_22px_rgba(211,110,51,0.2)] md:hidden"
      href={primaryCtaUrl}
    >
      대상 확인
    </a>
  </div>
</header>
