---
const { brandName = "오일가이드" } = Astro.props;
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="brand" aria-label={`${brandName} 홈`}>
      <span class="brand__mark" aria-hidden="true">
        <svg viewBox="0 0 32 32" fill="none"><path d="M16 3.5c-5.6 7-9.5 12-9.5 17.1a9.5 9.5 0 0 0 19 0C25.5 15.5 21.6 10.5 16 3.5Z" fill="currentColor"/><path d="M11.7 21.5c.7 2.2 2.4 3.6 4.7 3.8" stroke="#FFF7E8" stroke-width="2.2" stroke-linecap="round"/></svg>
      </span>
      <span><strong>{brandName}</strong><small>FUEL &amp; ENERGY GUIDE</small></span>
    </a>
    <nav class="desktop-nav" aria-label="주요 메뉴">
      <a href="/#today-price">오늘의 유가</a>
      <a href="/fuel-cost-calculator/">주유비 계산</a>
      <a href="/#nearby-stations">주변 주유소</a>
      <a href="/benefits/">지원금</a>
    </nav>
    <a class="header-action" href="/fuel-cost-calculator/">내 주유비 계산</a>
  </div>
</header>
