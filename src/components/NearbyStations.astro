<section class="map-shell" id="nearby-stations">
  <div class="map-shell__head">
    <div class="section-heading section-heading--inverse">
      <p>NEARBY STATIONS</p>
      <h2>지금 내 주변의<br />주유소를 찾아보세요</h2>
      <div class="section-heading__description">위치 정보는 현재 검색에만 사용하며 저장하지 않습니다. 가격과 영업 여부는 방문 전 한 번 더 확인하세요.</div>
    </div>
    <button class="button button--amber" type="button" data-find-stations>
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-5.3 7-12a7 7 0 1 0-14 0c0 6.7 7 12 7 12Z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="9" r="2.4" stroke="currentColor" stroke-width="1.8"/></svg>
      내 위치로 찾기
    </button>
  </div>
  <div class="map-content">
    <div id="station-map" role="application" aria-label="주변 주유소 지도"></div>
    <aside class="map-panel">
      <div class="map-status" data-map-status>‘내 위치로 찾기’를 누르면 반경 5km 내 주유소를 지도와 목록으로 보여드립니다.</div>
      <div class="station-list" data-station-list></div>
    </aside>
  </div>
</section>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  const mapElement = document.querySelector("#station-map");
  const findButton = document.querySelector("[data-find-stations]");
  const status = document.querySelector("[data-map-status]");
  const list = document.querySelector("[data-station-list]");

  if (mapElement instanceof HTMLElement && findButton instanceof HTMLButtonElement && status && list) {
    const map = L.map(mapElement, { scrollWheelZoom: false }).setView([36.45, 127.85], 7);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);
    const stationLayer = L.layerGroup().addTo(map);
    const stationIcon = L.divIcon({ className: "station-marker", html: "O", iconSize: [34, 34] });
    const userIcon = L.divIcon({ className: "user-marker", html: "", iconSize: [20, 20] });

    const setStatus = (message) => { status.textContent = message; };
    const escapeHtml = (value) => String(value || "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]);
    const distanceKm = (lat1, lon1, lat2, lon2) => {
      const toRad = (degrees) => degrees * Math.PI / 180;
      const dLat = toRad(lat2 - lat1);
      const dLon = toRad(lon2 - lon1);
      const value = Math.sin(dLat / 2) ** 2 + Math.cos(toRad(lat1)) * Math.cos(toRad(lat2)) * Math.sin(dLon / 2) ** 2;
      return 6371 * 2 * Math.atan2(Math.sqrt(value), Math.sqrt(1 - value));
    };
    const fetchFromPublicMap = async (lat, lon) => {
      const query = `[out:json][timeout:18];(node["amenity"="fuel"](around:5000,${lat},${lon});way["amenity"="fuel"](around:5000,${lat},${lon});relation["amenity"="fuel"](around:5000,${lat},${lon}););out center tags;`;
      const response = await fetch("https://overpass.kumi.systems/api/interpreter", {
        method: "POST",
        body: new URLSearchParams({ data: query }),
        signal: AbortSignal.timeout(20000),
      });
      if (!response.ok) throw new Error("Public map unavailable");
      const payload = await response.json();
      return (payload.elements || []).map((item) => {
        const stationLat = Number(item.lat ?? item.center?.lat);
        const stationLon = Number(item.lon ?? item.center?.lon);
        if (!Number.isFinite(stationLat) || !Number.isFinite(stationLon)) return null;
        return {
          id: `${item.type}-${item.id}`,
          name: item.tags?.name || item.tags?.brand || "이름 미등록 주유소",
          brand: item.tags?.brand || item.tags?.operator || "",
          lat: stationLat,
          lon: stationLon,
          distanceKm: distanceKm(lat, lon, stationLat, stationLon),
        };
      }).filter(Boolean).sort((a, b) => a.distanceKm - b.distanceKm);
    };
    const renderStations = (stations, lat, lon) => {
      stationLayer.clearLayers();
      L.marker([lat, lon], { icon: userIcon, zIndexOffset: 1000 }).addTo(stationLayer).bindPopup("현재 위치");
      list.innerHTML = "";
      stations.slice(0, 12).forEach((station, index) => {
        const marker = L.marker([station.lat, station.lon], { icon: stationIcon }).addTo(stationLayer);
        marker.bindPopup(`<strong>${escapeHtml(station.name)}</strong><br><small>${escapeHtml(station.brand || "주유소")}</small>`);
        const item = document.createElement("article");
        item.className = "station-item";
        item.innerHTML = `<strong>${index + 1}. ${escapeHtml(station.name)}</strong><span>${escapeHtml(station.brand || "브랜드 정보 없음")} · 약 ${station.distanceKm.toFixed(1)}km</span><a href="https://www.opinet.co.kr/" target="_blank" rel="noopener noreferrer">오피넷에서 가격 확인 ↗</a>`;
        item.addEventListener("click", () => { map.setView([station.lat, station.lon], 16); marker.openPopup(); });
        list.appendChild(item);
      });
      const bounds = L.latLngBounds([[lat, lon], ...stations.slice(0, 12).map((station) => [station.lat, station.lon])]);
      map.fitBounds(bounds, { padding: [40, 40], maxZoom: 14 });
      setStatus(`반경 5km에서 주유소 ${stations.length}곳을 찾았습니다. 위치는 공개 지도 데이터 기준입니다.`);
    };

    findButton.addEventListener("click", () => {
      if (!navigator.geolocation) {
        setStatus("이 브라우저에서는 위치 기능을 지원하지 않습니다. 오피넷에서 지역을 직접 검색해 주세요.");
        return;
      }
      findButton.disabled = true;
      setStatus("현재 위치를 확인하고 주변 주유소를 찾는 중입니다.");
      navigator.geolocation.getCurrentPosition(async ({ coords }) => {
        try {
          let stations;
          try {
            const response = await fetch(`/api/nearby-stations.json?lat=${coords.latitude}&lon=${coords.longitude}`);
            const payload = await response.json();
            if (!response.ok || !Array.isArray(payload.stations)) throw new Error(payload.message);
            stations = payload.stations;
          } catch {
            stations = await fetchFromPublicMap(coords.latitude, coords.longitude);
          }
          renderStations(stations, coords.latitude, coords.longitude);
        } catch {
          setStatus("주변 주유소 데이터를 잠시 불러오지 못했습니다. 잠시 후 다시 시도하거나 오피넷을 이용해 주세요.");
        } finally {
          findButton.disabled = false;
        }
      }, () => {
        setStatus("위치 권한이 허용되지 않았습니다. 브라우저의 위치 권한을 허용한 뒤 다시 눌러주세요.");
        findButton.disabled = false;
      }, { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 });
    });
  }
</script>
