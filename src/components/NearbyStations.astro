<section class="map-shell" id="nearby-stations">
  <div class="map-shell__head">
    <div class="map-heading-row">
      <div class="section-heading section-heading--inverse">
        <p>NEARBY STATIONS</p>
        <h2>위치 허용 없이도<br />주변 주유소를 찾으세요</h2>
        <div class="section-heading__description">지역을 직접 고르거나 현재 위치를 사용할 수 있습니다. 오피넷이 제공하는 판매가격과 거리를 함께 비교하세요.</div>
      </div>
      <button class="button button--amber" type="button" data-find-stations>
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 21s7-5.3 7-12a7 7 0 1 0-14 0c0 6.7 7 12 7 12Z" stroke="currentColor" stroke-width="1.8"/><circle cx="12" cy="9" r="2.4" stroke="currentColor" stroke-width="1.8"/></svg>
        내 위치로 찾기
      </button>
    </div>
    <form class="map-search" data-region-form>
      <label>
        <span>지역 선택</span>
        <select data-region-select>
          <option value="37.5665,126.9780">서울 중심</option>
          <option value="35.1796,129.0756">부산 중심</option>
          <option value="35.8714,128.6014">대구 중심</option>
          <option value="37.4563,126.7052">인천 중심</option>
          <option value="35.1595,126.8526">광주 중심</option>
          <option value="36.3504,127.3845">대전 중심</option>
          <option value="35.5395,129.3114">울산 중심</option>
          <option value="36.4800,127.2890">세종 중심</option>
          <option value="37.2636,127.0286">수원 중심</option>
          <option value="37.8813,127.7300">춘천 중심</option>
          <option value="36.6424,127.4890">청주 중심</option>
          <option value="35.8242,127.1480">전주 중심</option>
          <option value="34.9904,126.4817">무안·전남 중심</option>
          <option value="36.5684,128.7294">안동·경북 중심</option>
          <option value="35.2285,128.6811">창원 중심</option>
          <option value="33.4996,126.5312">제주 중심</option>
        </select>
      </label>
      <label>
        <span>유종</span>
        <select data-product-select>
          <option value="B027">휘발유</option>
          <option value="D047">경유</option>
          <option value="K015">LPG</option>
        </select>
      </label>
      <button class="button map-search__submit" type="submit">선택 지역 검색</button>
    </form>
  </div>
  <div class="map-content">
    <div id="station-map" role="application" aria-label="주변 주유소 지도"></div>
    <aside class="map-panel">
      <div class="map-status" data-map-status>지역을 선택하거나 내 위치를 사용하면 반경 5km의 주유소를 가격순으로 보여드립니다.</div>
      <button class="map-center-button" type="button" data-center-search>지금 보이는 지도 중심에서 찾기</button>
      <div class="station-list" data-station-list></div>
    </aside>
  </div>
</section>

<script>
  import L from "leaflet";
  import "leaflet/dist/leaflet.css";

  const mapElement = document.querySelector("#station-map");
  const findButton = document.querySelector("[data-find-stations]");
  const centerButton = document.querySelector("[data-center-search]");
  const regionForm = document.querySelector("[data-region-form]");
  const regionSelect = document.querySelector("[data-region-select]");
  const productSelect = document.querySelector("[data-product-select]");
  const status = document.querySelector("[data-map-status]");
  const list = document.querySelector("[data-station-list]");

  if (mapElement instanceof HTMLElement && findButton instanceof HTMLButtonElement && centerButton instanceof HTMLButtonElement && regionForm instanceof HTMLFormElement && regionSelect instanceof HTMLSelectElement && productSelect instanceof HTMLSelectElement && status && list) {
    const map = L.map(mapElement, { scrollWheelZoom: false }).setView([36.45, 127.85], 7);
    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      maxZoom: 19,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);
    const stationLayer = L.layerGroup().addTo(map);
    const stationIcon = L.divIcon({ className: "station-marker", html: "O", iconSize: [34, 34] });
    const userIcon = L.divIcon({ className: "user-marker", html: "", iconSize: [20, 20] });
    const productNames = { B027: "휘발유", D047: "경유", K015: "LPG" };

    const setStatus = (message) => { status.textContent = message; };
    const escapeHtml = (value) => String(value || "").replace(/[&<>"']/g, (char) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[char]);
    const formatPrice = (price) => Number(price).toLocaleString("ko-KR");

    const renderStations = (payload, lat, lon, locationName) => {
      const stations = payload.stations || [];
      const productName = productNames[payload.product] || "선택 유종";
      stationLayer.clearLayers();
      L.marker([lat, lon], { icon: userIcon, zIndexOffset: 1000 }).addTo(stationLayer).bindPopup(`${escapeHtml(locationName)} 검색 기준`);
      list.innerHTML = "";

      stations.slice(0, 12).forEach((station, index) => {
        const priceText = station.price ? `${formatPrice(station.price)}원/L` : "가격 확인 필요";
        const marker = L.marker([station.lat, station.lon], { icon: stationIcon }).addTo(stationLayer);
        marker.bindPopup(`<strong>${escapeHtml(station.name)}</strong><br><small>${escapeHtml(station.brand || "주유소")} · ${priceText}</small>`);
        const item = document.createElement("article");
        item.className = "station-item";
        item.innerHTML = `<div><strong>${index + 1}. ${escapeHtml(station.name)}</strong><span>${escapeHtml(station.brand || "브랜드 정보 없음")} · 약 ${Number(station.distanceKm).toFixed(1)}km</span></div><b>${priceText}</b>`;
        item.addEventListener("click", () => { map.setView([station.lat, station.lon], 16); marker.openPopup(); });
        list.appendChild(item);
      });

      const points = [[lat, lon], ...stations.slice(0, 12).map((station) => [station.lat, station.lon])];
      map.fitBounds(L.latLngBounds(points), { padding: [40, 40], maxZoom: 14 });
      const sourceText = payload.livePrices ? "오피넷 실시간 판매가격 기준" : "공개 지도 위치정보 기준";
      setStatus(`${locationName} 반경 5km · ${productName} 주유소 ${stations.length}곳 · ${sourceText}`);
    };

    const searchStations = async (lat, lon, locationName) => {
      const roundedLat = Number(lat).toFixed(3);
      const roundedLon = Number(lon).toFixed(3);
      const product = productSelect.value;
      findButton.disabled = true;
      centerButton.disabled = true;
      setStatus(`${locationName} 주변 주유소를 찾는 중입니다.`);
      try {
        const response = await fetch(`/api/nearby-stations.json?lat=${roundedLat}&lon=${roundedLon}&product=${product}`);
        const payload = await response.json();
        if (!response.ok || !Array.isArray(payload.stations)) throw new Error(payload.message);
        renderStations(payload, Number(roundedLat), Number(roundedLon), locationName);
      } catch {
        setStatus("주변 주유소 데이터를 잠시 불러오지 못했습니다. 잠시 후 다시 시도해 주세요.");
      } finally {
        findButton.disabled = false;
        centerButton.disabled = false;
      }
    };

    regionForm.addEventListener("submit", (event) => {
      event.preventDefault();
      const [lat, lon] = regionSelect.value.split(",").map(Number);
      searchStations(lat, lon, regionSelect.options[regionSelect.selectedIndex].text);
    });

    centerButton.addEventListener("click", () => {
      const center = map.getCenter();
      searchStations(center.lat, center.lng, "지도 중심");
    });

    findButton.addEventListener("click", () => {
      if (!navigator.geolocation) {
        setStatus("이 브라우저에서는 위치 기능을 지원하지 않습니다. 지역 선택 검색을 이용해 주세요.");
        return;
      }
      setStatus("현재 위치를 확인하는 중입니다. 위치 권한 요청을 허용해 주세요.");
      navigator.geolocation.getCurrentPosition(
        ({ coords }) => searchStations(coords.latitude, coords.longitude, "내 위치"),
        () => setStatus("위치 권한을 사용하지 않아도 됩니다. 위의 지역 선택 검색을 이용해 주세요."),
        { enableHighAccuracy: false, timeout: 10000, maximumAge: 300000 },
      );
    });
  }
</script>
