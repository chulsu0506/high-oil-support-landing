---
const { brandName, ownerName, supportEmail } = Astro.props;
---

<footer class="mx-auto max-w-6xl px-4 pb-24 pt-10 text-sm text-stone-500 md:px-6 md:pb-12">
  <div class="flex flex-col gap-4 border-t border-stone-200/80 pt-6 md:flex-row md:items-end md:justify-between">
    <div>
      <strong class="block text-stone-900">{brandName}</strong>
      <p class="mt-2 leading-7">
        Copyright {new Date().getFullYear()}. {ownerName}. All rights reserved.
      </p>
    </div>
    <div class="flex flex-wrap gap-4">
      <a href="/privacy-policy" class="transition hover:text-stone-900">개인정보처리방침</a>
      <a href="/terms" class="transition hover:text-stone-900">이용약관</a>
      <a href={`mailto:${supportEmail}`} class="transition hover:text-stone-900">{supportEmail}</a>
    </div>
  </div>
</footer>
