---
const { brandName = "오일가이드", ownerName, supportEmail } = Astro.props;
---

<footer class="site-footer">
  <div class="site-footer__top">
    <div>
      <a class="brand brand--footer" href="/">
        <span class="brand__mark" aria-hidden="true">
          <svg viewBox="0 0 32 32" fill="none"><path d="M16 3.5c-5.6 7-9.5 12-9.5 17.1a9.5 9.5 0 0 0 19 0C25.5 15.5 21.6 10.5 16 3.5Z" fill="currentColor"/></svg>
        </span>
        <span><strong>{brandName}</strong><small>기름값과 에너지비를 더 쉽게</small></span>
      </a>
      <p class="site-footer__note">공식 기관의 공개정보를 생활에 필요한 계산과 안내로 정리합니다.</p>
    </div>
    <div class="site-footer__links">
      <a href="/fuel-cost-calculator/">주유비 계산기</a>
      <a href="/benefits/">에너지 지원</a>
      <a href="https://www.opinet.co.kr/" target="_blank" rel="noopener noreferrer">오피넷</a>
      <a href={`mailto:${supportEmail}`}>문의하기</a>
    </div>
  </div>
  <div class="site-footer__bottom">
    <span>© {new Date().getFullYear()} {ownerName}. All rights reserved.</span>
    <span><a href="/privacy-policy/">개인정보처리방침</a><a href="/terms/">이용약관</a></span>
  </div>
</footer>
